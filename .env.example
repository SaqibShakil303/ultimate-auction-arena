# ───────── Web client (read at BUILD time by Vite — set these on Netlify / Vercel) ─────────

# Address of the game server. Only needed when the client is hosted separately from it.
# Accepts https://host, wss://host/ws or just host.
# VITE_WS_URL=https://your-game-server.onrender.com

# ───────── Game server (read at START time — set these on Render / Railway / Fly / your VPS) ─────────

# Port to listen on. Hosting platforms set PORT themselves; SERVER_PORT wins when both are set.
# SERVER_PORT=8787

# Comma-separated sites allowed to open game sockets. Unset = any site.
# A leading *. matches every sub-domain (handy for preview deployments).
# ALLOWED_ORIGINS=https://your-site.netlify.app,https://*.vercel.app

# off = do not serve the web client from this server (WebSocket-only mode).
# SERVE_CLIENT=off

# Room persistence. Rooms are saved to a JSON file so a restart restores running auctions (paused).
# DATA_FILE=server/data/rooms.json
# PERSIST=off

# Safety limits.
# MAX_ROOMS=500
# MAX_CONNECTIONS=2000
