{
  "name": "ultimate-auction-arena",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Real-time multiplayer Football & Heroes auction game with official EA SPORTS FC 27 ratings",
  "scripts": {
    "dev": "concurrently -k -n server,web -c magenta,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "npm run build:web && npm run build:server",
    "start": "node dist-server/index.mjs --prod",
    "test": "vitest run",
    "test:browser": "playwright test",
    "audit:assets": "tsx scripts/audit-assets.ts",
    "typecheck": "tsc --noEmit",
    "build:web": "tsc --noEmit && vite build",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist-server/index.mjs --external:bufferutil --external:utf-8-validate --log-level=warning --banner:js=\"import{createRequire as __cr}from'node:module';const require=__cr(import.meta.url);\"",
    "start:ts": "tsx server/index.ts --prod",
    "test:all": "npm run typecheck && npm test && npm run build && npm run test:browser",
    "data:fc27": "node scripts/fetch-fc27.mjs",
    "data:portraits": "tsx scripts/fetch-portraits.ts"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "framer-motion": "^14.14.0",
    "lucide-react": "^1.73.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
